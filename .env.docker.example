# Copia este archivo como ".env" en la raíz del repo y completa los valores. ".env" no se sube a git.
# Genera cada valor con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Opcional. Solo si quieres probar el 2FA en local (junto con REQUIRE_2FA=true).
TWO_FACTOR_ENCRYPTION_KEY=
REQUIRE_2FA=false
POSTGRES_PASSWORD=
