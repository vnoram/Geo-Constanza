# === Servidor ===
PORT=3005
NODE_ENV=development

FRONTEND_URL=http://localhost:5173

# === Base de Datos PostgreSQL ===
DATABASE_URL=
# disable | require | verify. Por defecto: require en producción (cifrado sin validar certificado), disable en desarrollo.
# Con verify se valida el certificado; DATABASE_SSL_CA admite la CA en PEM (saltos de línea como \n).
DATABASE_SSL=
DATABASE_SSL_CA=

# URL pública de la API (solo para listarla en /api-docs)
PUBLIC_API_URL=

# === Redis ===
REDIS_URL=

# === JWT ===
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY_GGSS=30m
JWT_ACCESS_EXPIRY_SUPERVISOR=2h
JWT_ACCESS_EXPIRY_ADMIN=4h
JWT_REFRESH_EXPIRY=7d

# === Firebase Cloud Messaging ===
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# === Azure Blob Storage ===
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=reportes

# === CORS ===
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# === Segundo factor (2FA TOTP) ===
# Clave para cifrar el secreto TOTP en la base. Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Obligatoria en producción para supervisor/administrador. Si se pierde, hay que reiniciar el 2FA de los usuarios.
TWO_FACTOR_ENCRYPTION_KEY=
TWO_FACTOR_ISSUER=Geo Constanza
# true = exige el código TOTP a quien ya enroló 2FA. Si se omite: activo solo con NODE_ENV=production.
# En desarrollo local / Docker puede ir en false.
REQUIRE_2FA=

# === Rate Limiting ===
# Opcional: solo reduce el máximo ordinario (base 42; 40 desde 26-04-2028).
MAX_HORAS_SEMANALES=
RATE_LIMIT_PUBLIC=100
RATE_LIMIT_AUTHENTICATED=500

# Correo saliente (restablecer contraseña). Cualquier proveedor SMTP.
# Sin SMTP_HOST/MAIL_FROM: en desarrollo el enlace se imprime en consola; en producción no se envía y se registra el error.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# FRONTEND_URL (ya definida arriba) se usa para armar el enlace /restablecer?token=...
