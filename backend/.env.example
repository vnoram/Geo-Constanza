# === Servidor ===
PORT=3005
NODE_ENV=development

FRONTEND_URL=http://localhost:5173

# === Base de Datos PostgreSQL ===
DATABASE_URL=

# === Redis ===
REDIS_URL=

# === JWT ===
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY_GGSS=30m
JWT_ACCESS_EXPIRY_SUPERVISOR=2h
JWT_ACCESS_EXPIRY_ADMIN=4h
JWT_REFRESH_EXPIRY=7d

# === Firebase Cloud Messaging ===
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# === Azure Blob Storage ===
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=reportes

# === CORS ===
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# === Rate Limiting ===
# Máximo semanal de cobertura: pendiente de acordar antes de habilitar aprobaciones.
MAX_HORAS_SEMANALES=
RATE_LIMIT_PUBLIC=100
RATE_LIMIT_AUTHENTICATED=500
